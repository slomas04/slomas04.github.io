---
import { Font } from "astro:assets";

const site_title : string = "slomfish's site"
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="./favicon.svg" />

        <Font cssVariable="--font-terminess-mono" />
		<Font cssVariable="--font-segoeui" />
		<script src="../scripts/videoplayer.js"></script>
		
		<meta name="generator" content={Astro.generator} />
		<title>{site_title}</title>
	</head>
	<body class="static overflow-x-hidden overflow-y-hidden">
		
		<div id="video-container" class="z-1 absolute w-full h-full
										flex align-center">
			<video id="background-video" 
				   src="./src/videos/forestbackdrop.mp4" autoplay loop
				   class = "hidden"/>
			<canvas id="video-canvas" class=""/>
		</div>

		<div class="w-full h-screen flex 
                    justify-center items-center z-5 absolute">
			<slot/>
		</div>
	</body>
</html>