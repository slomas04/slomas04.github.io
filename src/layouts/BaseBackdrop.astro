---
import { Font, Image } from "astro:assets";

import SiteIndex from "../components/SiteIndex.astro";
import forestBackdrop from "../videos/forestbackdrop.mp4";
import blueNoise from "../images/bluenoise_rgba_1024.png";
import PageColumn from "../components/PageColumn.astro";

const site_title : string = "slomfish's site";
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="./favicon.svg" />
		
        <Font cssVariable="--font-terminess-mono" />
		<Font cssVariable="--font-segoeui" />
		<script src="../scripts/videoplayer.js"></script>
		
		<meta name="generator" content={Astro.generator} />
		<title>{site_title}</title>
	</head>
	<body class="static overflow-x-hidden overflow-y-hidden">

		<div class="w-dvw h-dvh flex 
                    justify-center items-center z-5 absolute">
			<div id="site-index-container"
			     class="flex flex-col sm:flex-row w-full sm:w-5/6 2xl:w-3/5 h-full sm:h-9/10">
				<SiteIndex />
				<PageColumn>
					<slot/>
				</PageColumn>
			</div>
		</div>

		<div id="background-cover" 
		     class="w-full h-full absolute overflow-x-hidden overflow-y-hidden
			        bg-olive-400 z-2 duration-500"/>

		<div id="video-container" class="z-1 absolute w-dvw h-dvh
										flex align-center
										overflow-x-hidden
										overflow-y-hidden">
			<video id="background-video" 
				   src={forestBackdrop} loop muted preload="metadata"
				   class = "hidden"/>
			<Image src={blueNoise} alt="Blue Noise pattern for dithering" 
			       class="hidden" id="blue-noise"/>
			<canvas id="video-canvas" class="block"/>
		</div>
	</body>
</html>