---
import { Image } from 'astro:assets';

import BaseBackdrop from '../layouts/BaseBackdrop.astro';
import ColumnElement from '../components/ColumnElement.astro'
import "../styles/global.css";

// Grafted from https://stackoverflow.com/questions/4060004/calculate-age-given-the-birth-date-in-the-format-yyyymmdd
const getAge = (birthDate: string) => Math.floor((new Date().valueOf() - new Date(birthDate).getTime()) / 3.15576e+10);
const age = getAge("2004-07-07")
---

<BaseBackdrop>
	<ColumnElement>
		<div class="flex flex-row justify-between">
			<div>
				<p class="font-mono text-lg">
					Name: Sam <br>
					Pronouns: Any/All <br>
					Age: {age}
				</p>
				<p class=""><br>
					British software and data engineer based in Wales 🏴󠁧󠁢󠁷󠁬󠁳󠁿.
					<br>This is my personal site, where you can experience my ramblings and recommendations.
				</p>
			</div>
			<div class="flex flex-col justify-center ml-5 min-w-2/5 2xl:min-w-1/5">
				<img src="https://media.slom.fish/images/me-asf.png" alt="Bourdain in Europe with a baguette and a coffee"
						class="grayscale mix-blend-color-dodge"/>
				<p class="text-xs italic">(Me asf on a Thursday afternoon)</p>
			</div>
		</div>
	</ColumnElement>
	<ColumnElement>
		<script src="../scripts/quickmusicstats.js"/>
		<div class=" flex flex-col sm:flex-row justify-between w-full">
			<div id="flex flex-col w-1/2">
				<p class="font-bold text-xl">This month on <a class="underline" href="https://www.last.fm/user/Slomas04">last.fm</a>:</p>
				<div class="flex flex-row text-right items-baseline">
					<p id="total_listens"></p>
					<p class="">&nbsp;total streams</p>
				</div>
				<div class="flex flex-row text-right items-baseline">
					<p id="avg_per_day"></p>
					<p class="">&nbsp;streams per day</p>
					<p class="text-sm italic">&nbsp;(avg)</p>
				</div>
				<div class="flex flex-row text-right items-baseline">
					<p id="unique_artists"></p>
					<p class="">&nbsp;unique artists</p>
				</div>
				<div class="flex flex-row text-right items-baseline">
					<p id="unique_albums"></p>
					<p class="">&nbsp;unique albums</p>
				</div>
				<div class="flex flex-row text-right items-baseline">
					<p class="">Busiest hour: &nbsp;</p>
					<p id="busiest_hour"></p>
					<p class="text-sm italic" id="busiest_hour_tz"></p>
				</div>
			</div>
			<div class="flex flex-row w-1/2 justify-between mr-4">
				<div class="flex-grow flex-col w-full">
					<p class="text-left font-bold text-xl">Top album:</p>
					<p class="text-right font-bold" id="topalbum_name"></p>
					<div class="text-right flex flex-row items-baseline justify-end">
						<p class="text-right text-sm italic">by&nbsp;</p>
						<p class="text-right" id="topalbum_artist"></p>
					</div>
					<p class="text-right" id="topalbum_plays"></p>
				</div>
				<img class="ml-2 grow-0 h-42" id="topalbum_img" alt="Top album, this month">
			</div>
		</div>
	</ColumnElement>
	<ColumnElement>
		<div class="mx-4">
			<p class="text-left">mi olin ale</p>
			<div class="flex justify-center content-center">
				<img src="https://media.slom.fish/images/flags/bi_flag.png" alt="Bisexual Flag" class="h-10 w-full"/>
				<img src="https://media.slom.fish/images/flags/bi_gf_dither.png" alt="Bisexual Flag blend" class="h-10 w-60"/>
				<img src="https://media.slom.fish/images/flags/gf_flag.png" alt="Genderfluid Flag" class="h-10 w-full"/>
			</div>
			<p class="text-right">mi sama ale</p>
		</div>
	</ColumnElement>
</BaseBackdrop>
