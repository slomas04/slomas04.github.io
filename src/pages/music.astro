---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import "../styles/global.css";
import { getFormattedAlbumDict } from '../scripts/collectionHandling';

import BaseBackdrop from '../layouts/BaseBackdrop.astro';
import ColumnElement from '../components/ColumnElement.astro';
import AlbumBorder from '../components/AlbumBorder.astro'

const albums = await getFormattedAlbumDict(await getCollection('albums'));

---

<BaseBackdrop>
    <ColumnElement>
        <p class="text-2xl">Music</p><br>
        <p>PLACEHOLDER</p>
    </ColumnElement>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-2">
        {albums.map( album => (
            <AlbumBorder>
                <div class="flex flex-col w-full">
                    <div class="flex flex-row justify-between w-full">
                        <img src={album.url} alt={album.title} class="p-1 w-1/3"/>
                        <div class="flex flex-col w-2/3">
                            <div class="flex flex-row justify-between w-full">
                                <span>{album.title}</span> 
                                <span class="text-sm italic text-olive-400">({album.rel_year})</span>
                            </div>
                            <span class="pl-4">{album.artist}</span>
                        </div>
                    </div>
                    <div class="hidden">
                        <span>{album.comment}</span>
                        <span>Favourite track: {album.favourite}</span>
                        <span class="text-xs italic text-olive-400">Added {album.date_added}</span>
                    </div>
                </div>
            </AlbumBorder>
        ))}
    </div>
</BaseBackdrop>