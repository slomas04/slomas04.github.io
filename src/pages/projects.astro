---
// @ts-nocheck

import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';

import BaseBackdrop from '../layouts/BaseBackdrop.astro';
import ColumnElement from '../components/ColumnElement.astro'
import "../styles/global.css";

const projects = await getCollection('projects')
const EntryDivClass = `flex flex-col bg-stone-700 hover:bg-stone-800
                       w-full my-2 px-3 py-2 rounded-md
                       transition duration-300 ease-in-out 
                       sm:hover:scale-105`

projects.sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
---

<BaseBackdrop>
    <ColumnElement>
        <div class="flex flex-col p-2">
            <p class="text-xl mb-2">Projects</p>
            <p class="">This is a directory of all my projects to date. Some are complete and polished, while others are just proofs of concept or datasets.</p>
        </div>
    </ColumnElement>

    <div class="bg-[#2b2b2255] text-olive-300 text-shadow-lg/30
         shadow-xl/20 shadow-olive-800/50 rounded-lg w-full my-2 px-6 py-4">
        <div class="flex flex-col p-2">
            { projects.map(project => (
                <a href={`/projects/${project.id}`}>
                <div class={EntryDivClass}>
                    <p class="text-xl">{project.data.title}</p>
                    <p class="">{project.data.description}</p>
                    <p class="italic text-right text-sm">Created {
                        project.data.date.toLocaleDateString("en-GB", {
                            month: 'long', year: 'numeric'
                        })}
                    </p>
                </div></a>
            ))}
        </div>
    </div>
</BaseBackdrop>