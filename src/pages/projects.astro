---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';

import BaseBackdrop from '../layouts/BaseBackdrop.astro';
import ColumnElement from '../components/ColumnElement.astro'
import "../styles/global.css";

const projects = await getCollection('projects')
const EntryDivClass = `flex flex-col border-3 border-amber-600 bg-amber-900 border-single 
                       w-full my-2 px-2 py-1 rounded-md`
---

<BaseBackdrop>
    <ColumnElement>
        <div class="flex flex-col p-2">
            <p class="text-xl mb-2">Projects</p>
            <p class="">This is a directory of all my projects to date. Some are complete and polished, while others are just proofs of concept or datasets.</p>
        </div>
    </ColumnElement>

    <ColumnElement>
        <div class="flex flex-col p-2">
            { projects.map(project => (
                <a href={`/projects/${project.id}`}>
                <div class={EntryDivClass}>
                    <p class="text-xl">{project.data.title}</p>
                    <p class="">{project.data.description}</p>
                    <p class="italic text-right text-sm">Created {
                        project.data.date.toLocaleDateString("en-GB", {
                            month: 'long', year: 'numeric'
                        })
                    }</p>
                </div></a>
            ))}
        </div>
    </ColumnElement>
</BaseBackdrop>