---
// @ts-nocheck

import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';

import BaseBackdrop from '../layouts/BaseBackdrop.astro';
import ColumnElement from '../components/ColumnElement.astro'
import "../styles/global.css";

const recipes = await getCollection('recipes')
const EntryDivClass = `flex flex-col bg-sky-900 
                       w-full my-2 px-2 py-1 rounded-md
                       transition duration-300 ease-in-out 
                       sm:hover:scale-105`

recipes.sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
---

<BaseBackdrop>
    <ColumnElement>
        <div class="flex flex-col p-2">
            <p class="text-xl mb-2">My recipe book</p>
            <p class="">Enjoy cooking? So do I!<br>If you dare, you can cook some of these for yourself :) Let me know how they turn out!</p>
        </div>
    </ColumnElement>

    <div class="bg-[#2b2b2255] text-olive-300 text-shadow-lg/30
         shadow-xl/20 shadow-olive-800/50 rounded-lg w-full my-2 px-6 py-4">
        <div class="flex flex-col p-2">
            { recipes.map(project => (
                <a href={`/recipes/${project.id}`}>
                <div class={EntryDivClass}>
                    <p class="text-xl">{project.data.title}</p>
                    <p class="">{project.data.description}</p>
                    <p class="italic text-right text-sm">Created {
                        project.data.date.toLocaleDateString("en-GB", {
                            month: 'long', year: 'numeric'
                        })}
                    </p>
                </div></a>
            ))}
        </div>
    </div>
</BaseBackdrop>