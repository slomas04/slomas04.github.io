---
import { getCollection, render } from 'astro:content';
import BaseBackdrop from '../../layouts/BaseBackdrop.astro';
import ColumnElement from '../../components/ColumnElement.astro'
import "../../styles/global.css";

export async function getStaticPaths() {
  const posts = await getCollection('recipes');
  return posts.map(post => ({
    params: { 
        id: post.id,
    },
    props: { post },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseBackdrop>
    <ColumnElement>
        <div class="flex flex-col p-2">
            <div class="flex-row flex justify-between">
                <a href="/projects/" class="font-mono px-2 rounded-sm bg-sky-900 hover:underline hover:cursor-pointer">&lt- Back</a>
                <p class="text-right text-sm italic px-2 rounded-sm bg-sky-900">{
                    post.data.date.toLocaleDateString("en-GB", {
                        day: 'numeric', month: 'long', year: 'numeric'
                    })
                }</p>
            </div>
            <h2 class="font-bold">{post.data.title}</h2>
            <p class="text-md ml-4">{post.data.description}</p>
        </div>
    </ColumnElement>

    <ColumnElement>
        <Content />
    </ColumnElement>
</BaseBackdrop>